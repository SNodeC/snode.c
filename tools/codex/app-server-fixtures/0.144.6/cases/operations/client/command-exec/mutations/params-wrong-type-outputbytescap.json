{
  "command": [
    "synthetic-tool",
    "--synthetic-flag",
    "synthetic argument"
  ],
  "cwd": "/synthetic/project",
  "disableOutputCap": false,
  "disableTimeout": false,
  "env": {
    "SYNTHETIC_UNSET": null,
    "SYNTHETIC_VALUE": "synthetic-environment-value"
  },
  "outputBytesCap": false,
  "processId": "synthetic-process-id",
  "sandboxPolicy": {
    "networkAccess": false,
    "type": "readOnly"
  },
  "size": {
    "cols": 80,
    "rows": 24
  },
  "streamStdin": false,
  "streamStdoutStderr": false,
  "timeoutMs": 0,
  "tty": false
}
